# ═══════════════════════════════════════════════════════
# 🔑  TravioX API Keys — Fill in your own values
# ═══════════════════════════════════════════════════════

# Groq (LLM) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# SerpAPI (Flights + Hotels) — https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# RapidAPI (News) — https://rapidapi.com
RAPID_API_KEY=your_rapidapi_key_here

# Unsplash (Photos) — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Sarvam AI (TTS + Translation) — https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Creatomate (Video Generation) — https://creatomate.com
CREATOMATE_API_KEY=your_creatomate_api_key_here
CREATOMATE_TEMPLATE_ID=your_creatomate_template_id_here

# Geoapify (Live Map — Geocoding, Routing, Reverse Geocoding) — https://geoapify.com
GEOAPIFY_KEY=your_geoapify_api_key_here

# ═══════════════════════════════════════════════════════
# ⚙️  Server Config
# ═══════════════════════════════════════════════════════
PORT=3000
NODE_ENV=development
